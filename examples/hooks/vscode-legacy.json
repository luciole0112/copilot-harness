{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node scripts/hook.mjs start --legacy",
        "cwd": ".",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": "node scripts/hook.mjs guard --legacy",
        "cwd": ".",
        "timeout": 10
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "node scripts/hook.mjs audit --legacy",
        "cwd": ".",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node scripts/hook.mjs stop --legacy",
        "cwd": ".",
        "timeout": 10
      }
    ],
    "PreCompact": [
      {
        "type": "command",
        "command": "node scripts/hook.mjs checkpoint --legacy",
        "cwd": ".",
        "timeout": 10
      }
    ]
  }
}
